# Copy to .env and set a strong password before the first start.
# Never place this file or private data in web/public or web/dist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000

# Local API port; Compose uses port 3000 inside the container.
PORT=3001
# DATA_DIR defaults to the repository's data/ directory locally.
# DATA_DIR=/absolute/path/to/private-data

# Approved defaults. Expired sessions require sign-in again.
SESSION_TTL_DAYS=7
# Oversized requests return 413 without saving incomplete data.
MAX_UPLOAD_MIB=512
MAX_JSON_MIB=32

# Optional public analytics IDs; never add private credentials here.
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
